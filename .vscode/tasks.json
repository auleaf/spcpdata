{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-DHAVE_MYSQL",
                "-DHAVE_MYSQL=1",
                "-fdiagnostics-color=always",
                "-I/Users/mac/cplusplusprj/httpserver/external/httplib",
                "-I/Users/mac/cplusplusprj/httpserver/external/json",
                "-I/usr/local/Cellar/mysql-client/9.5.0/include/mysql",
                "-I/Users/mac/cplusplusprj/httpserver/src",
                "-L/usr/local/Cellar/mysql-client/9.5.0/lib",
                //"-v",
                "-g",
                "-std=gnu++17",
                "${file}",
                "/Users/mac/cplusplusprj/httpserver/src/mysql_wrapper.cpp",
                //"-lstdc++",
                "-lmysqlclient",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
               // "$(mysql_config --libs)"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}